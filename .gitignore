# Everything is ignored by default. What the repository publishes is listed below:
# the analysis code, the README, and the figures and supplementary table of the paper.
# Input data, intermediate results and the ARACNe output are not versioned; the
# scripts regenerate them from the public sources listed in the README.
*
!**/

# code
!.gitignore
!README.md
!*.R
!*.sh

# the figures of the paper and the supplementary table;
# the vector PDFs are kept local, the PNGs are what the README shows
!figures/*.png
!tables/*.csv
figures/*.sh

# the manuscript and its supplementary material stay local
Article_writting/

# ARACNe input expression matrices and their cohort metadata, versioned by
# explicit request (everything else under these dirs stays local)
!03_preprocessing/2_7_Full_counts_A7_annot.tsv
!03_preprocessing/2_8_Full_counts_A9_annot.tsv
!03_preprocessing/validation_uganda/2_7_Full_counts_A7_annot.tsv
!03_preprocessing/validation_uganda/2_8_Full_counts_A9_annot.tsv
!03_preprocessing/validation_uganda/2_4_Factors.tsv
!02_cohort_data/1_Output_rds/2_2_CESC_TCGA_GTEx_metadata_clade.rds
!02_cohort_data/validation_uganda/1_Output/1_1_HTMCP_clinical_HPV_HIV_table.tsv

# editor, session and build scratch
.claude/
.Rproj.user/
__pycache__/
node_modules/
*.swp
.DS_Store
